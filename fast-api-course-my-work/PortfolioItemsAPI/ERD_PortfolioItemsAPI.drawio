<mxfile host="app.diagrams.net" modified="2026-11-16T20:20:00.000Z" agent="GitHub Copilot" version="26.0.16" type="device">
  <diagram id="erd-portfolio-items-api" name="PortfolioItemsAPI ERD">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PortfolioItemsAPI - ERD" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=22;fontStyle=1;fontColor=#243746;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Trenutno stanje prema SQLAlchemy modelima: users, categories i items" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=none;fontSize=13;fontColor=#526575;" vertex="1" parent="1">
          <mxGeometry x="30" y="58" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;hr&gt;id : Integer [PK, auto, index]&lt;br&gt;name : String [NN]&lt;br&gt;email : String [NN, UQ]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2df;strokeColor=#b18a50;fontColor=#243746;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="150" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;br&gt;&lt;hr&gt;id : Integer [PK, auto, index]&lt;br&gt;name : String [NN, UQ]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#e8f1f8;strokeColor=#5b7f99;fontColor=#243746;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="390" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="items" value="&lt;b&gt;items&lt;/b&gt;&lt;br&gt;&lt;hr&gt;id : Integer [PK, auto, index]&lt;br&gt;title : String [NN]&lt;br&gt;description : String [NULL]&lt;br&gt;price : Numeric(10, 2) [NN]&lt;br&gt;status : Enum [draft, published] [NN, default=draft, CHECK]&lt;br&gt;created_at : DateTime [NN, server_default=func.now()]&lt;br&gt;updated_at : DateTime [NN, server_default=func.now(), onupdate=func.now()]&lt;br&gt;owner_id : Integer [FK, NN]&lt;br&gt;category_id : Integer [FK, NN]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#edf5e8;strokeColor=#76945f;fontColor=#243746;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="540" height="350" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Oznake&lt;/b&gt;&lt;br&gt;PK = primarni ključ; FK = strani ključ; auto = automatski ID&lt;br&gt;NN = nullable=False; NULL = nullable=True; UQ = unique=True&lt;br&gt;index = index=True; CHECK = ograničenje dozvoljenih statusa&lt;br&gt;server_default = podrazumevana vrednost na strani baze" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f4f6f7;strokeColor=#9aa9b2;fontColor=#344955;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="590" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="scope_note" value="&lt;b&gt;Napomene&lt;/b&gt;&lt;br&gt;Linije prikazuju FK veze; relationship() atributi nisu definisani u trenutnim modelima.&lt;br&gt;FK kolone su obavezne, pa je veza od svakog users/categories reda ka items 1:N.&lt;br&gt;Nije naveden ON DELETE CASCADE/RESTRICT. SQLite FK proveru treba uključiti po konekciji.&lt;br&gt;onupdate=func.now() važi za SQLAlchemy UPDATE, nije SQLite trigger." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff8e8;strokeColor=#c8a557;fontColor=#4c432d;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="590" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="fk_users_items" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#526575;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="users" target="items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fk_categories_items" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#526575;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="categories" target="items">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
